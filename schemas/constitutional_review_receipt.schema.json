{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/grandchallenge/INTELLECT/schemas/constitutional_review_receipt.schema.json",
  "title": "Grand Intellect constitutional review receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "staffing_mode",
    "human_steward",
    "proposal_authors",
    "packet_sha256",
    "subjects",
    "signoffs",
    "recorded_at",
    "status",
    "authority_boundary"
  ],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "campaign_id": {"type": "string", "minLength": 1},
    "staffing_mode": {"const": "steward_supervised_agents"},
    "human_steward": {"type": "string", "minLength": 1},
    "proposal_authors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "pull_request", "head_sha"],
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^grandchallenge/[A-Za-z0-9._-]+$"
          },
          "pull_request": {"type": "integer", "minimum": 1},
          "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
        }
      }
    },
    "signoffs": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "office",
          "reviewer",
          "reviewer_kind",
          "session_id",
          "authentication_id",
          "authenticated_at",
          "attestation_record",
          "attestation_sha256"
        ],
        "properties": {
          "office": {
            "enum": ["adversary", "referee", "human_steward"]
          },
          "reviewer": {"type": "string", "minLength": 1},
          "reviewer_kind": {"enum": ["agent", "human"]},
          "session_id": {"type": ["string", "null"], "minLength": 1},
          "authentication_id": {"type": "string", "minLength": 1},
          "authenticated_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "attestation_record": {"type": "string", "format": "uri"},
          "attestation_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "recorded_at": {"type": "string", "format": "date-time"},
    "status": {"const": "complete"},
    "authority_boundary": {"type": "string", "minLength": 1}
  }
}
