{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/grandchallenge/INTELLECT/schemas/multi_role_review.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "work_class", "reviewer_system_id", "logical_pass_id", "role", "mode", "subject", "criteria", "finding", "evidence", "unresolved_obligations", "reserved_authority_ref"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "work_class": {"enum": ["routine_bounded", "substantive", "reserved"]},
    "reviewer_system_id": {"type": "string", "minLength": 1},
    "logical_pass_id": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "mode": {"enum": ["authoring", "non_authoring_read_only"]},
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "commit", "tree", "material_evidence_sha256"],
      "properties": {
        "repository": {"type": "string", "pattern": "^grandchallenge/[A-Za-z0-9._-]+$"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "material_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "criteria": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "finding": {"enum": ["approved", "changes_requested", "rejected", "abstained", "not_applicable"]},
    "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "unresolved_obligations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "reserved_authority_ref": {"type": ["string", "null"]}
  }
}
