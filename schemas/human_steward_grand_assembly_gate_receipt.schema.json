  "properties":{
    "schema_version":{"const":"1.0"},"receipt_id":{"type":"string","minLength":1},"matter_id":{"const":"GI-GRAND-ASSEMBLY-PROXY-DELEGATION-001"},"status":{"const":"effective"},
    "subject":{"type":"object","additionalProperties":false,"required":["repository","pull_request","head_sha"],"properties":{"repository":{"const":"grandchallenge/INTELLECT"},"pull_request":{"const":57},"head_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"}}},
    "packet":{"type":"object","additionalProperties":false,"required":["motion_sha256","disposition_sha256","required_office_count","passage_rule"],"properties":{"motion_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"disposition_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"required_office_count":{"const":15},"passage_rule":{"const":"fifteen_office_full_quorum_unanimous_consent"}}},
