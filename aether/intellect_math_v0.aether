# GI-MS-WP00 future semantic projection.
#
# GitHub is authoritative in the present release. These predicates describe the
# future AETHER projection of the GitHub-first lineage events. They do not claim
# that an AETHER namespace has been registered or populated.

schema intellect_math_v0 {
  attr math.campaign_id: ScalarLWW<String>
  attr math.programme_ref: ScalarLWW<String>
  attr math.route_status: ScalarLWW<String>
  attr math.solve_work_package_id: ScalarLWW<String>
  attr math.solve_repository: ScalarLWW<String>
  attr math.solve_issue: ScalarLWW<String>
  attr math.solve_commit: ScalarLWW<String>
  attr math.waiver_id: ScalarLWW<String>
  attr math.claim_id: RefSet<Entity>
  attr math.cert_handoff_id: RefSet<Entity>
  attr math.cert_status: ScalarLWW<String>
  attr math.github_lineage_json: ScalarLWW<String>
}

predicates {
  math_campaign_id(Entity, String)
  math_route_status(Entity, String)
  math_solve_work_package_id(Entity, String)
  math_claim_id(Entity, Entity)
  math_cert_handoff_id(Entity, Entity)
  math_cert_status(Entity, String)
  math_governed(Entity)
  math_exempted(Entity)
  math_routed(Entity)
  math_claim_handed_off(Entity, Entity)
}

rules {
  math_governed(wp) <- math_route_status(wp, "governed"), math_solve_work_package_id(wp, solve_wp)
  math_exempted(wp) <- math_route_status(wp, "exempted")
  math_routed(wp) <- math_governed(wp)
  math_routed(wp) <- math_exempted(wp)
  math_claim_handed_off(wp, claim) <- math_claim_id(wp, claim), math_cert_handoff_id(claim, handoff), math_cert_status(handoff, status)
}

materialize {
  math_governed
  math_exempted
  math_routed
  math_claim_handed_off
}

query {
  current
  goal math_routed(wp)
  keep wp
}
